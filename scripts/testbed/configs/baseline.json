{
  "name": "baseline-mirror-vs-off",
  "binary": "/build/main/bin/llama-cli",
  "model": "/models/gemma-4-26B-A4B-it-UD-IQ4_XS.gguf",
  "prompt": "Write a detailed essay about the history of computing, starting with mechanical calculators and ending with modern GPUs.",
  "n_predict": 128,
  "threads": 8,
  "reps": 5,
  "warmup": 1,
  "common_args": ["-c", "4096", "--no-display-prompt"],
  "common_env": {
    "GGML_NUMA_FAKE": "2",
    "GGML_NUMA_XGMI_GBPS": "60"
  },
  "variants": [
    {
      "name": "A-no-numa",
      "args": [],
      "env": {}
    },
    {
      "name": "B-mirror",
      "args": ["--numa", "mirror"],
      "env": {}
    },
    {
      "name": "C-mirror-pin-cpu",
      "args": ["--numa", "mirror"],
      "env": { "GGML_NUMA_PIN": "cpu" }
    }
  ]
}
