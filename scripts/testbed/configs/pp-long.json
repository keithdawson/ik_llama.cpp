{
  "name": "pp-long-mirror-vs-off",
  "binary": "/build/main/bin/llama-cli",
  "model": "/models/gemma-4-26B-A4B-it-UD-IQ4_XS.gguf",
  "prompt_file": "/src/scripts/testbed/prompts/pp-long.txt",
  "n_predict": 32,
  "threads": 8,
  "reps": 4,
  "warmup": 1,
  "common_args": ["-c", "4096", "--no-display-prompt"],
  "common_env": {
    "GGML_NUMA_FAKE": "2",
    "GGML_NUMA_XGMI_GBPS": "60"
  },
  "variants": [
    {
      "name": "A-no-numa",
      "args": [],
      "env": {}
    },
    {
      "name": "B-mirror",
      "args": ["--numa", "mirror"],
      "env": {}
    },
    {
      "name": "C-mirror-hier-all",
      "args": ["--numa", "mirror"],
      "env": { "GGML_NUMA_HIER_BATCH_MAX": "-1" }
    }
  ]
}
